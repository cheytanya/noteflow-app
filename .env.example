# NoteFlow Production & Development Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Persistent Database Configuration (PostgreSQL)
# When set, NoteFlow uses PostgreSQL. When omitted in dev, NoteFlow falls back to server/data/db.json
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noteflow

# JWT Security
JWT_SECRET=noteflow_secure_jwt_secret_key_change_in_production_2026

# Dynamic Frontend API Base URL (Leave blank if served by same Express origin)
VITE_API_URL=

# Dynamic Frontend WebSocket Base URL (Leave blank if served by same Express origin)
VITE_WS_URL=
